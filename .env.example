POSTGRES_DB=imagelite
POSTGRES_USER=imagelite
POSTGRES_PASSWORD=imagelite-local-only
JWT_SECRET=local-development-secret-change-before-production
SPRING_JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used only by the optional pgAdmin service (`--profile tools`).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin-local-only
